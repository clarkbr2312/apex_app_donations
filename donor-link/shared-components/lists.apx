list access-control (
    name: Access Control
    config {
        buildOption: @feature-access-control
    }

    entry access-control (
        label: Access Control
        icon {
            imageIconCssClasses: fa-key
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 10020
            }
        }
        userDefinedAttributes {
            1: Change access control settings and disable access control
        }
    )

    entry users (
        label: Users
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10021
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Set level of access for authenticated users of this application
        }
    )

)

list activity-reports (
    name: Activity Reports
    config {
        buildOption: @feature-activity-reporting
    }

    entry application-error-log (
        label: Application Error Log
        icon {
            imageIconCssClasses: fa-exclamation
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 10012
                clearCache: 10012
            }
        }
        userDefinedAttributes {
            1: Report of errors logged by this application
        }
    )

    entry automations-log (
        label: Automations Log
        icon {
            imageIconCssClasses: fa-gears
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 10015
                clearCache: 10015
                action: resetRegions
            }
        }
        userDefinedAttributes {
            1: Report of automation executions and messages logged by this application
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from apex_appl_automations a, apex_automation_log l
                where a.automation_id = l.automation_id
                and l.application_id = :APP_ID
                ```
        }
    )

    entry dashboard (
        label: Dashboard
        icon {
            imageIconCssClasses: fa-area-chart
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10010
                clearCache: 10010
            }
        }
        userDefinedAttributes {
            1: View application activity metrics
        }
    )

    entry page-performance (
        label: Page Performance
        icon {
            imageIconCssClasses: fa-file-chart
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 10013
                clearCache: 10013
            }
        }
        userDefinedAttributes {
            1: Report of activity and performance by application page
        }
    )

    entry page-views (
        label: Page Views
        icon {
            imageIconCssClasses: fa-file-search
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 10014
                clearCache: 10014
                action: resetRegions
            }
        }
        userDefinedAttributes {
            1: Report of each page view by user including date of access and elapsed time
        }
    )

    entry top-users (
        label: Top Users
        icon {
            imageIconCssClasses: fa-user-chart
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 10011
                clearCache: 10011
            }
        }
        userDefinedAttributes {
            1: Report of page views aggregated by user
        }
    )

)

list feedback (
    name: Feedback
    config {
        buildOption: @feature-feedback
    }

    entry user-feedback (
        label: User Feedback
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10033
                clearCache: 10033
            }
        }
        userDefinedAttributes {
            1: Report of all feedback submitted by application users
        }
    )

)

list navbar (
    name: Navbar

    entry APP-USER-MENU (
        label: Logout
        icon {
            imageIconCssClasses: FA-USER
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 1
            }
        }
        serverSideCondition {
            type: currentPage!=page
            page: 1
        }
    )

    entry invite-a-donor (
        label: Invite a donor
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 3
                session: &APP_SESSION..
            }
        }
        serverSideCondition {
            type: currentPageInList
            pages: 1
        }
    )

    entry invite-a-non-profit (
        label: Invite a non-profit
        layout {
            sequence: 20
        }
        serverSideCondition {
            type: currentPageInList
            pages: 1
        }
    )

    entry login (
        label: Login
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 3
            }
        }
        serverSideCondition {
            type: currentPageInList
            pages: 1
        }
    )

    entry logout (
        label: Logout
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 60
            parentEntry: @APP-USER-MENU
        }
        link {
            target: {
                type: url
                url: "&LOGOUT_URL. "
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry register-a-non-profit (
        label: Register a non-profit
        layout {
            sequence: 10
        }
        serverSideCondition {
            type: currentPageInList
            pages: 1
        }
    )

)

list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry feedback (
        label: Feedback
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10030
                items: {
                    P10030_PAGE_ID: &APP_PAGE_ID.
                }
                clearCache: 10030
                action: resetPagination
            }
        }
        userDefinedAttributes {
            2: icon-only
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_util.feedback_enabled
        }
        config {
            buildOption: @feature-feedback
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 40
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-user-wrench
        }
        layout {
            sequence: 500000
        }
        link {
            target: {
                page: 10000
            }
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry audit-reports (
