            imageIconCssClasses: "fa-handshake "
        }
        layout {
            sequence: 100
        }
        link {
            target: {
                page: 5
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry non-profits (
        label: Non-profits
        icon {
            attributes: fa-users
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry stripe-payments (
        label: Stripe Payments
        icon {
            imageIconCssClasses: fa-dollar
        }
        layout {
            sequence: 300
        }
        link {
            target: {
                page: 1
            }
        }
    )

)

list register-a-non-profit (
    name: register a non-profit

    entry invite-a-donor (
        label: Invite a donor
        layout {
            sequence: 20
        }
    )

    entry invite-a-non-profit (
        label: Invite a non-profit
        layout {
            sequence: 10
        }
    )

    entry login (
        label: Login
        layout {
            sequence: 30
        }
    )

)

