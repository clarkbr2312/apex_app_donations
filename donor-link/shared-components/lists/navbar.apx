list navbar (
    name: Navbar

    entry APP-USER-MENU (
        label: Logout
        icon {
            imageIconCssClasses: FA-USER
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 1
            }
        }
        serverSideCondition {
            type: currentPage!=page
            page: 1
        }
    )

    entry invite-a-donor (
        label: Invite a donor
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 19
            }
        }
        serverSideCondition {
            type: currentPageInList
            pages: 1
        }
    )

    entry invite-a-non-profit (
        label: Invite a non-profit
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 20
            }
        }
        serverSideCondition {
            type: currentPageInList
            pages: 1
        }
    )

    entry login (
        label: Login
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 3
            }
        }
        serverSideCondition {
            type: currentPageInList
            pages: 1
        }
    )

    entry logout (
        label: Logout
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 60
            parentEntry: @APP-USER-MENU
        }
        link {
            target: {
                type: url
                url: "&LOGOUT_URL. "
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry register-a-non-profit (
        label: Register a non-profit
        layout {
            sequence: 10
        }
        serverSideCondition {
            type: currentPageInList
            pages: 1
        }
    )

)

