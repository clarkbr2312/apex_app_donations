lov feedback-status (
    name: FEEDBACK_STATUS
    source {
        location: staticValues
    }

    entry 0 (
        sequence: 1
        display: No Action
        return: 0
    )

    entry 1 (
        sequence: 2
        display: Acknowledged
        return: 1
    )

    entry 3 (
        sequence: 3
        display: Open
        return: 3
    )

    entry 4 (
        sequence: 4
        display: Closed
        return: 4
    )

)

