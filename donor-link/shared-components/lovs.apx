lov access-roles (
    name: ACCESS_ROLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select role_name d, role_id r
            from APEX_APPL_ACL_ROLES where application_id = :APP_ID 
            order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov dl-users-username (
    name: DL_USERS.USERNAME
    source {
        tableName: DL_USERS
    }
    columnMapping {
        return: USER_ID
        display: USERNAME
        defaultSort: USERNAME
    }
)

lov email-username-format (
    name: EMAIL_USERNAME_FORMAT
    source {
        location: staticValues
    }

    entry email (
        sequence: 1
        display: Email Addresses
        return: EMAIL
    )

)

lov feedback-rating (
    name: FEEDBACK_RATING
    source {
        location: staticValues
    }

    entry 1 (
        sequence: 3
        display: Negative
        return: 1
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-frown-o fa-2x feedback-negative" aria-hidden="true" ></span></span>
        }
    )

    entry 2 (
        sequence: 2
        display: Neutral
        return: 2
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-emoji-neutral fa-2x feedback-neutral" aria-hidden="true" ></span></span>
        }
    )

    entry 3 (
        sequence: 1
        display: Positive
        return: 3
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-smile-o fa-2x feedback-positive" aria-hidden="true" ></span></span>
        }
    )

)

lov feedback-status (
    name: FEEDBACK_STATUS
    source {
        location: staticValues
    }

    entry 0 (
        sequence: 1
        display: No Action
        return: 0
    )

    entry 1 (
        sequence: 2
        display: Acknowledged
        return: 1
    )

    entry 3 (
        sequence: 3
        display: Open
        return: 3
    )

    entry 4 (
        sequence: 4
        display: Closed
        return: 4
    )

)

lov timeframe-4-weeks (
    name: TIMEFRAME (4 WEEKS)
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select disp,
                   val as seconds
              from table( apex_util.get_timeframe_lov_data )
             order by insert_order
            ```
    }
    columnMapping {
        return: SECONDS
        display: DISP
    }
)

lov view-as-report-chart (
    name: VIEW_AS_REPORT_CHART
    source {
        location: staticValues
    }

    entry chart (
        sequence: 2
        display: Add Chart Page
        return: CHART
        globalization {
            template: <span class="fa fa-pie-chart" aria-hidden="true"></span><span class="u-VisuallyHidden">#DISPLAY_VALUE#</span>
        }
    )

    entry report (
        sequence: 1
        display: Add Report Page
        return: REPORT
        globalization {
            template: <span class="fa fa-table" aria-hidden="true"></span><span class="u-VisuallyHidden">#DISPLAY_VALUE#</span>
        }
    )

)

