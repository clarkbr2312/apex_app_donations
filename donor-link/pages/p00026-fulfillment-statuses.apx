page 26 (
    name: Fulfillment Statuses
    alias: FULFILLMENT-STATUSES
    title: Fulfillment Statuses
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region fulfillment-statuses (
        name: Fulfillment Statuses
        title: Fulfillment Status
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: DL_FULFILLMENT_STATUS_LOOKUP
            orderByClause: status_name
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 46070533838509514
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @STATUS_ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @STATUS_CODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @STATUS_NAME
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESCRIPTION
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @DISPLAY_ORDER
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @IS_ACTIVE
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DESCRIPTION (
            type: textField
            heading {
                heading: Description
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DISPLAY_ORDER (
            type: numberField
            heading {
                heading: Display Order
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: DISPLAY_ORDER
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IS_ACTIVE (
            type: switch
            heading {
                heading: Enabled
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: IS_ACTIVE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column STATUS_CODE (
            type: textField
            heading {
                heading: Status Code
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 30
            }
            source {
                databaseColumn: STATUS_CODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column STATUS_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: STATUS_ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column STATUS_NAME (
            type: textField
            heading {
                heading: Status Name
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 50
            }
            source {
                databaseColumn: STATUS_NAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Fulfillment Status
        }
    )

    process fulfillment-statuses-save-interactive-grid-data (
        name: Fulfillment Statuses - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @fulfillment-statuses
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 46071437997509523
        }
    )

)

