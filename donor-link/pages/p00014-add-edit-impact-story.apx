page 14 (
    name: "Add / Edit Impact Story"
    alias: ADD-EDIT-IMPACT-STORY
    title: "Add / Edit Impact Story"
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region form (
        name: "Impact Story Details"
        type: staticContent
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P14_STORY_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
    )

    pageItem P14_CHARITY_ID (
        type: hidden
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
    )

    pageItem P14_TITLE (
        type: textField
        label {
            label: "Impact Story Title"
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            valuePlaceholder: "e.g. Winter Warmth Shelter Drive 2025"
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
    )

    pageItem P14_IMPACT_METRIC (
        type: textField
        label {
            label: "Impact Metric Callout"
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            valuePlaceholder: "e.g. 500 Families Sheltered, 1,200 Meals Served"
        }
        validation {
            maxLength: 100
        }
    )

    pageItem P14_EVENT_DATE (
        type: datePicker
        label {
            label: "Event / Completion Date"
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
    )

    pageItem P14_STORY_NARRATIVE (
        type: richTextEditor
        label {
            label: "Story Narrative"
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
        settings {
            format: html
            minHeight: 200
        }
    )

    pageItem P14_DISPLAY_ORDER (
        type: numberField
        label {
            label: "Display Order"
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
    )

    pageItem P14_MEDIA_FILE (
        type: fileUpload
        label {
            label: "Story Photo / Media Image"
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
        display {
            displayAs: blockDropzone
            dropzoneTitle: "Drop story photo here"
            dropzoneDesc: "or click to browse"
        }
        storage {
            type: appTempFiles
            allowMultipleFiles: false
            fileTypes: "image/*"
        }
    )

    pageItem P14_MEDIA_URL (
        type: textField
        label {
            label: "Or Media URL (External Link)"
        }
        layout {
            sequence: 90
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
        validation {
            maxLength: 500
        }
    )

    region buttons (
        name: "Buttons"
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    button cancel (
        buttonName: CANCEL
        label: "Cancel"
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        behavior {
            action: definedByDynamicAction
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
    )

    button save (
        buttonName: SAVE
        label: "Save Impact Story"
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        behavior {
            action: submitPage
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    dynamicAction cancel-dialog (
        name: "Cancel Dialog"
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }
        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process fetch-story-details (
        name: "Fetch Impact Story Details"
        type: executeCode
        execution {
            sequence: 10
            point: beforeHeader
        }
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P14_STORY_ID IS NOT NULL THEN
                        SELECT title, story_narrative, media_url, impact_metric, event_date, display_order
                          INTO :P14_TITLE, :P14_STORY_NARRATIVE, :P14_MEDIA_URL, :P14_IMPACT_METRIC, :P14_EVENT_DATE, :P14_DISPLAY_ORDER
                          FROM dl_charity_portfolio_stories
                         WHERE story_id = TO_NUMBER(:P14_STORY_ID);
                    END IF;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        NULL;
                END;
                ```
        }
    )

    process save-story-details (
        name: "Save Impact Story Details"
        type: executeCode
        execution {
            sequence: 10
            point: afterSubmit
        }
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_media_url VARCHAR2(500) := :P14_MEDIA_URL;
                BEGIN
                    -- Process staged media file if uploaded via APEX_APPLICATION_TEMP_FILES
                    IF :P14_MEDIA_FILE IS NOT NULL THEN
                        FOR r IN (
                            SELECT filename, name 
                              FROM apex_application_temp_files 
                             WHERE name = :P14_MEDIA_FILE
                        ) LOOP
                            v_media_url := r.name;
                        END LOOP;
                    END IF;

                    IF :P14_STORY_ID IS NOT NULL THEN
                        -- Update existing impact story
                        UPDATE dl_charity_portfolio_stories
                           SET title           = :P14_TITLE,
                               story_narrative = :P14_STORY_NARRATIVE,
                               media_url       = v_media_url,
                               impact_metric   = :P14_IMPACT_METRIC,
                               event_date      = TO_DATE(:P14_EVENT_DATE, 'YYYY-MM-DD'),
                               display_order   = NVL(TO_NUMBER(:P14_DISPLAY_ORDER), 10)
                         WHERE story_id        = TO_NUMBER(:P14_STORY_ID);
                    ELSE
                        -- Insert new impact story
                        INSERT INTO dl_charity_portfolio_stories (
                            charity_id,
                            title,
                            story_narrative,
                            media_url,
                            impact_metric,
                            event_date,
                            display_order
                        ) VALUES (
                            TO_NUMBER(:P14_CHARITY_ID),
                            :P14_TITLE,
                            :P14_STORY_NARRATIVE,
                            v_media_url,
                            :P14_IMPACT_METRIC,
                            TO_DATE(:P14_EVENT_DATE, 'YYYY-MM-DD'),
                            NVL(TO_NUMBER(:P14_DISPLAY_ORDER), 10)
                        );
                    END IF;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process close-dialog (
        name: "Close Dialog"
        type: closeDialog
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )
)
