page 10 (
    name: Edit Header & Branding
    alias: EDIT-HEADER-BRANDING
    title: Edit Header & Branding
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Header & Branding Details
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P10_CHARITY_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
    )

    pageItem P10_COVER_PHOTO_FILE (
        type: fileUpload
        label {
            label: Header Cover Photo Image
        }
        display {
            displayAs: blockDropzone
            dropzoneTitle: Drop cover photo image here
            dropzoneDesc: or click to browse
        }
        storage {
            type: appTempFiles
            fileTypes: image/*
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
    )

    pageItem P10_COVER_PHOTO_URL (
        type: textField
        label {
            label: Or Cover Photo URL (External Link)
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
        validation {
            maxLength: 500
        }
    )

    pageItem P10_LOGO_FILE (
        type: fileUpload
        label {
            label: Organization Logo Image
        }
        display {
            displayAs: blockDropzone
            dropzoneTitle: Drop logo image here
            dropzoneDesc: or click to browse
        }
        storage {
            type: appTempFiles
            fileTypes: image/*
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
    )

    pageItem P10_LOGO_URL (
        type: textField
        label {
            label: Or Logo Image URL (External Link)
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
        validation {
            maxLength: 500
        }
    )

    pageItem P10_TAGLINE (
        type: textarea
        label {
            label: Tagline / Impact Pitch
        }
        settings {
            autoHeight: true
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            valuePlaceholder: Short 1-2 sentence pitch summarizing your mission...
        }
        validation {
            maxLength: 500
        }
    )

    pageItem P10_TRADING_NAME (
        type: textField
        label {
            label: Public Display Name (DBA)
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            valuePlaceholder: e.g. Austin Youth Shelter
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P10_WEBSITE_URL (
        type: textField
        label {
            label: Website URL
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
        validation {
            maxLength: 500
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Save Branding Changes
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 20
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 41004560047449628
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process fetch-branding-details (
        name: Fetch Branding Details
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P10_CHARITY_ID IS NOT NULL THEN
                        SELECT trading_name, tagline, website_url, logo_url, cover_photo_url
                          INTO :P10_TRADING_NAME, :P10_TAGLINE, :P10_WEBSITE_URL, :P10_LOGO_URL, :P10_COVER_PHOTO_URL
                          FROM dl_charity_profiles
                         WHERE charity_id = TO_NUMBER(:P10_CHARITY_ID);
                    END IF;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        NULL;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 41004311133449628
        }
    )

    process save-branding-details (
        name: Save Branding Details
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_logo_url  VARCHAR2(500) := :P10_LOGO_URL;
                    v_cover_url VARCHAR2(500) := :P10_COVER_PHOTO_URL;
                BEGIN
                    -- Process staged logo file if uploaded via APEX_APPLICATION_TEMP_FILES
                    IF :P10_LOGO_FILE IS NOT NULL THEN
                        FOR r IN (
                            SELECT filename, name 
                              FROM apex_application_temp_files 
                             WHERE name = :P10_LOGO_FILE
                        ) LOOP
                            v_logo_url := r.name;
                        END LOOP;
                    END IF;
                
                    -- Process staged cover photo file if uploaded via APEX_APPLICATION_TEMP_FILES
                    IF :P10_COVER_PHOTO_FILE IS NOT NULL THEN
                        FOR r IN (
                            SELECT filename, name 
                              FROM apex_application_temp_files 
                             WHERE name = :P10_COVER_PHOTO_FILE
                        ) LOOP
                            v_cover_url := r.name;
                        END LOOP;
                    END IF;
                
                    -- Update charity profile record
                    UPDATE dl_charity_profiles
                       SET trading_name    = :P10_TRADING_NAME,
                           tagline         = :P10_TAGLINE,
                           website_url     = :P10_WEBSITE_URL,
                           logo_url        = v_logo_url,
                           cover_photo_url = v_cover_url
                     WHERE charity_id = TO_NUMBER(:P10_CHARITY_ID);
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 41004487835449628
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

