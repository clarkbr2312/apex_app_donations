page 21 (
    name: Order Fulfillment Tracking
    alias: ORDER-FULFILLMENT-TRACKING
    title: Order Fulfillment Tracking — DonorLink
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region fulfillment-ig-region (
        name: Order Fulfillment Registry
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT d.donation_id,
                       c.legal_name AS charity_name,
                       wi.product_title,
                       d.donation_amount,
                       d.created_at AS donation_date,
                       d.fulfillment_status_id,
                       d.stripe_payment_intent
                  FROM dl_donations_log d
                  JOIN dl_charity_wishlist_items wi ON wi.item_id = d.item_id
                  JOIN dl_charity_profiles c ON c.charity_id = wi.charity_id
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        pagination {
            type: page
        }
        messages {
            whenNoDataFound: No donations or fulfillment records found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
                pdf
            ]
            filename: order_fulfillment_report
        }
        advanced {
            savedReportMappingIdentifier: 42994998336828663
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_SELECTOR
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 20
                }
            )

            displayColumn (
                column: @DONATION_ID
                layout {
                    sequence: 30
                }
            )

            displayColumn (
                column: @CHARITY_NAME
                layout {
                    sequence: 40
                }
            )

            displayColumn (
                column: @PRODUCT_TITLE
                layout {
                    sequence: 50
                }
            )

            displayColumn (
                column: @DONATION_AMOUNT
                layout {
                    sequence: 60
                }
            )

            displayColumn (
                column: @DONATION_DATE
                layout {
                    sequence: 70
                }
            )

            displayColumn (
                column: @FULFILLMENT_STATUS_ID
                layout {
                    sequence: 80
                }
            )

            displayColumn (
                column: @STRIPE_PAYMENT_INTENT
                layout {
                    sequence: 90
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CHARITY_NAME (
            type: textField
            heading {
                heading: Non-Profit Charity
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: CHARITY_NAME
                dataType: varchar2
            }
            readOnly {
                type: always
            }
        )

        column DONATION_AMOUNT (
            type: numberField
            heading {
                heading: Gift Amount
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 99,990.00
            }
            source {
                databaseColumn: DONATION_AMOUNT
                dataType: number
            }
            readOnly {
                type: always
            }
        )

        column DONATION_DATE (
            type: datePicker
            heading {
                heading: Date Funded
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                databaseColumn: DONATION_DATE
                dataType: date
            }
            readOnly {
                type: always
            }
        )

        column DONATION_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: DONATION_ID
                dataType: number
                primaryKey: true
            }
        )

        column FULFILLMENT_STATUS_ID (
            type: selectList
            heading {
                heading: Fulfillment Status
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT status_name AS d, status_id AS r
                      FROM dl_fulfillment_status_lookup
                     WHERE is_active = 'Y'
                     ORDER BY display_order
                    ```
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: FULFILLMENT_STATUS_ID
                dataType: number
            }
        )

        column PRODUCT_TITLE (
            type: textField
            heading {
                heading: Funded Item
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: PRODUCT_TITLE
                dataType: varchar2
            }
            readOnly {
                type: always
            }
        )

        column STRIPE_PAYMENT_INTENT (
            type: textField
            heading {
                heading: Payment Reference ID
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: STRIPE_PAYMENT_INTENT
                dataType: varchar2
            }
            readOnly {
                type: always
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region kpi-summary-cards (
        name: Fulfillment Overview Metrics
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'Awaiting Purchase' AS card_title,
                       'Needs Processing' AS card_subtitle,
                       TO_CHAR(COUNT(CASE WHEN d.fulfillment_status_id = 1 THEN 1 END)) AS card_value,
                       'fa-clock-o' AS card_icon
                  FROM dl_donations_log d
                UNION ALL
                SELECT 'In Transit / Shipped' AS card_title,
                       'Out for Delivery' AS card_subtitle,
                       TO_CHAR(COUNT(CASE WHEN d.fulfillment_status_id = 2 THEN 1 END)) AS card_value,
                       'fa-truck' AS card_icon
                  FROM dl_donations_log d
                UNION ALL
                SELECT 'Delivered & Complete' AS card_title,
                       'Fulfilled' AS card_subtitle,
                       TO_CHAR(COUNT(CASE WHEN d.fulfillment_status_id = 3 THEN 1 END)) AS card_value,
                       'fa-check-circle' AS card_icon
                  FROM dl_donations_log d
                UNION ALL
                SELECT 'Total Gifted Value' AS card_title,
                       'USD' AS card_subtitle,
                       TO_CHAR(NVL(SUM(d.donation_amount), 0), '$999,990.00') AS card_value,
                       'fa-dollar' AS card_icon
                  FROM dl_donations_log d
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleA
            ]
        }
        componentAppearance {
            gridColumns: 4
        }
        card {
            primaryKeyColumn1: CARD_TITLE
        }
        title {
            column: CARD_TITLE
        }
        subtitle {
            column: CARD_SUBTITLE
        }
        body {
            column: CARD_VALUE
        }
        iconAndBadge {
            iconSource: iconClassColumn
            iconColumn: CARD_ICON
            iconPosition: top
        }
    )

    process save-fulfillment-ig (
        name: Save Order Fulfillment Changes
        type: interactiveGridAutoRowProcessing
        editableRegion: @fulfillment-ig-region
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 42997060236828664
        }
    )

)

