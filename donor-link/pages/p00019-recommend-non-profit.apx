page 19 (
    name: Recommend Non-Profit
    alias: RECOMMEND-NON-PROFIT
    title: Recommend a Cause — DonorLink
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-region (
        name: Modal Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region invite-form-region (
        name: Share & Recommend
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P19_CHARITY_ID (
        type: hidden
        layout {
            sequence: 10
            region: @invite-form-region
            slot: regionBody
        }
    )

    pageItem P19_FRIEND_EMAIL (
        type: textField
        label {
            label: Friend's Email Address
        }
        layout {
            sequence: 40
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            valuePlaceholder: sarah@example.com
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
    )

    pageItem P19_FRIEND_NAME (
        type: textField
        label {
            label: Friend's Name
        }
        layout {
            sequence: 30
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            valuePlaceholder: e.g. Sarah
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
    )

    pageItem P19_ITEM_ID (
        type: hidden
        layout {
            sequence: 20
            region: @invite-form-region
            slot: regionBody
        }
    )

    pageItem P19_PERSONAL_NOTE (
        type: textarea
        label {
            label: Personal Note
        }
        settings {
            autoHeight: true
        }
        layout {
            sequence: 70
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            valuePlaceholder: Add a short note to your friend...
        }
        validation {
            maxLength: 1000
        }
        default {
            type: static
            staticValue: Hey! I came across this inspiring cause on DonorLink and thought you would love to check out the great work they are doing.
        }
    )

    pageItem P19_YOUR_EMAIL (
        type: textField
        label {
            label: Your Email Address (Optional)
        }
        layout {
            sequence: 60
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            valuePlaceholder: alex@example.com
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P19_YOUR_NAME (
        type: textField
        label {
            label: Your Name
        }
        layout {
            sequence: 50
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            valuePlaceholder: e.g. Alex
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
    )

    button cancel_btn (
        buttonName: CANCEL_BTN
        label: Cancel
        layout {
            sequence: 10
            region: @buttons-region
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button send_invite_btn (
        buttonName: SEND_INVITE_BTN
        label: Send Recommendation ✉️
        layout {
            sequence: 20
            region: @buttons-region
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-paper-plane
        }
    )

    dynamicAction cancel-dialog-da (
        name: Cancel Recommendation Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel_btn
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog-after-send (
        name: Close Dialog After Send
        type: closeDialog
        execution {
            sequence: 20
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 42595782593468511
        }
        serverSideCondition {
            whenButtonPressed: @send_invite_btn
        }
    )

    process send-recommendation-email (
        name: Send Recommendation Process
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    -- Email dispatch logic will be attached here
                    NULL;
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 42595609448468511
        }
        serverSideCondition {
            whenButtonPressed: @send_invite_btn
        }
    )

)

