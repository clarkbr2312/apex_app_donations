page 7 (
    name: &P7_LEGAL_NAME.
    alias: PROFILE-P6-CHARITY-NAME
    title: &P7_LEGAL_NAME.
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region branding-image-gallery (
        name: Branding & Image Gallery
        type: staticContent
        layout {
            sequence: 20
