page 13 (
    name: "Add / Edit Team Member"
    alias: ADD-EDIT-TEAM-MEMBER
    title: "Add / Edit Team Member"
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region form (
        name: "Team Member Details"
        type: staticContent
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P13_MEMBER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
    )

    pageItem P13_CHARITY_ID (
        type: hidden
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
    )

    pageItem P13_FULL_NAME (
        type: textField
        label {
            label: "Full Name"
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            valuePlaceholder: "e.g. Jane Doe"
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
    )

    pageItem P13_ROLE_TITLE (
        type: textField
        label {
            label: "Role / Title"
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            valuePlaceholder: "e.g. Executive Director, Founder"
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
    )

    pageItem P13_BIO_SUMMARY (
        type: textarea
        label {
            label: "Bio Summary"
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            valuePlaceholder: "Brief background narrative about this team member..."
        }
        settings {
            autoHeight: true
        }
        validation {
            maxLength: 1000
        }
    )

    pageItem P13_DISPLAY_ORDER (
        type: numberField
        label {
            label: "Display Order"
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
        
    )

    pageItem P13_PHOTO_FILE (
        type: imageUpload
        label {
            label: "Member Headshot Photo"
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
    )

    pageItem P13_PHOTO_URL (
        type: textField
        label {
            label: "Or Photo URL (External Link)"
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-above
        }
        validation {
            maxLength: 500
        }
    )

    region buttons (
        name: "Buttons"
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    button cancel (
        buttonName: CANCEL
        label: "Cancel"
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        behavior {
            action: definedByDynamicAction
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
    )

    button save (
        buttonName: SAVE
        label: "Save Team Member"
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        behavior {
            action: submitPage
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    dynamicAction cancel-dialog (
        name: "Cancel Dialog"
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }
        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process fetch-member-details (
        name: "Fetch Team Member Details"
        type: executeCode
        execution {
            sequence: 10
            point: beforeHeader
        }
        source {
            plsqlCode:
                ```
                BEGIN
                    IF :P13_MEMBER_ID IS NOT NULL THEN
                        SELECT full_name, role_title, bio_summary, photo_url, display_order
                          INTO :P13_FULL_NAME, :P13_ROLE_TITLE, :P13_BIO_SUMMARY, :P13_PHOTO_URL, :P13_DISPLAY_ORDER
                          FROM dl_charity_team
                         WHERE member_id = TO_NUMBER(:P13_MEMBER_ID);
                    END IF;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        NULL;
                END;
                ```
        }
    )

    process save-member-details (
        name: "Save Team Member Details"
        type: executeCode
        execution {
            sequence: 10
            point: afterSubmit
        }
        source {
            plsqlCode:
                ```
                DECLARE
                    v_photo_url VARCHAR2(500) := :P13_PHOTO_URL;
                BEGIN
                    -- Process staged photo file if uploaded via APEX_APPLICATION_TEMP_FILES
                    IF :P13_PHOTO_FILE IS NOT NULL THEN
                        FOR r IN (
                            SELECT filename, name 
                              FROM apex_application_temp_files 
                             WHERE name = :P13_PHOTO_FILE
                        ) LOOP
                            v_photo_url := r.name;
                        END LOOP;
                    END IF;

                    IF :P13_MEMBER_ID IS NOT NULL THEN
                        -- Update existing team member
                        UPDATE dl_charity_team
                           SET full_name     = :P13_FULL_NAME,
                               role_title    = :P13_ROLE_TITLE,
                               bio_summary   = :P13_BIO_SUMMARY,
                               photo_url     = v_photo_url,
                               display_order = NVL(TO_NUMBER(:P13_DISPLAY_ORDER), 10)
                         WHERE member_id     = TO_NUMBER(:P13_MEMBER_ID);
                    ELSE
                        -- Insert new team member
                        INSERT INTO dl_charity_team (
                            charity_id,
                            full_name,
                            role_title,
                            bio_summary,
                            photo_url,
                            display_order
                        ) VALUES (
                            TO_NUMBER(:P13_CHARITY_ID),
                            :P13_FULL_NAME,
                            :P13_ROLE_TITLE,
                            :P13_BIO_SUMMARY,
                            v_photo_url,
                            NVL(TO_NUMBER(:P13_DISPLAY_ORDER), 10)
                        );
                    END IF;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process close-dialog (
        name: "Close Dialog"
        type: closeDialog
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )
)
