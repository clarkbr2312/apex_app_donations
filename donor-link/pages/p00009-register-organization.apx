page 9 (
    name: "Register Organization"
    alias: REGISTER-ORGANIZATION
    title: "Register Your Charity" 

    appearance {
        pageMode: modalDialog
        dialogTemplate: @/dialogs/modal-dialog
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region main-form-region (
        name: "Organization Registration"
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
        }
    )

    pageItem P9_LEGAL_NAME (
        type: textField
        label {
            label: "Legal Organization Name"
        }
        validation {
            valueRequired: true
        }
        layout {
            sequence: 10
            region: @main-form-region
            slot: body
        }
        appearance {
            template: @/required-above
        }
    )

    pageItem P9_NEW_CHARITY_ID (
        type: hidden
        layout {
            sequence: 5
            region: @main-form-region
        }
    )

    pageItem P9_EIN_NUMBER (
        type: textField
        label {
            label: "EIN / Tax ID Number"
        }
        validation {
            valueRequired: true
        }
        layout {
            sequence: 20
            region: @main-form-region
            slot: body
        }
        appearance {
            template: @/optional-floating
            valuePlaceholder: "e.g. 12-3456789"
        }
    )

    pageItem P9_PUBLIC_EMAIL (
        type: textField
        label {
            label: "Public Contact Email"
        }
        validation {
            valueRequired: true
        }
        layout {
            sequence: 30
            region: @main-form-region
            slot: body
        }
        appearance {
            template: @/optional-floating
            valuePlaceholder: "contact@organization.org"
        }
    )

    pageItem P9_CITY (
        type: textField
        label {
            label: "City"
        }
        validation {
            valueRequired: true
        }
        layout {
            sequence: 40
            region: @main-form-region
            slot: body
        }
        appearance {
            template: @/optional-floating
            valuePlaceholder: "e.g. Austin"
        }
    )

    pageItem P9_STATE_ID (
    type: selectList
    label {
        label: "State"
    }
    validation {
        valueRequired: true
    }
    lov {
        type: sqlQuery
                sqlQuery:
            ```sql
            SELECT state_name || ' (' || state_code || ')' AS d, state_id AS r
              FROM dl_us_states
             ORDER BY state_name
            ```
        displayNullValue: true
        nullValueDisplay: "- Select State -"
    }
    layout {
        sequence: 50
        region: @main-form-region
        slot: regionBody
    }
    appearance {
        template: @/optional-above
        templateOptions: #DEFAULT#
    }
)

    region footer-buttons-region (
        name: "Buttons"
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    button cancel_button (
        label: "Cancel"
        layout {
            sequence: 10
            region: @footer-buttons-region
            slot: regionBody
            position: create
        }
        behavior {
            type: triggerAction
        }
        appearance {
            template: @/text
        }
        action cancel_dialog_action (
            type: triggerAction
            event {
                type: click
            }
            actions {
                cancelDialog cancel_dlg ()
            }
        )
    )

    button submit_button (
        label: "Complete Registration & Build Profile"
        layout {
            sequence: 20
            region: @footer-buttons-region
            slot: regionBody
            position: create
        }
        behavior {
            type: submitPage
        }
        appearance {
            template: @/hot
        }
    )

    process create-organization-profile (
        name: "Create Organization & Location"
        type: executeCode
        execution {
            sequence: 10
            point: afterSubmit
        }
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_charity_id NUMBER;
                    v_slug       VARCHAR2(255);
                BEGIN
                    -- Generate clean public slug from legal name
                    v_slug := LOWER(REGEXP_REPLACE(:P9_LEGAL_NAME, '[^a-zA-Z0-9]+', '-'));
                    v_slug := TRIM(BOTH '-' FROM v_slug);

                    -- Insert new Charity Profile record
                    INSERT INTO dl_charity_profiles (
                        legal_name,
                        ein_number,
                        public_email,
                        public_slug,
                        tax_exempt_status,
                        mission_statement,
                        created_at
                    ) VALUES (
                        :P9_LEGAL_NAME,
                        :P9_EIN_NUMBER,
                        :P9_PUBLIC_EMAIL,
                        v_slug,
                        '501(c)(3) Verified',
                        'Connecting generous donors directly with verified community needs.',
                        SYSDATE
                    )
                    RETURNING charity_id INTO v_charity_id;

                    :P9_NEW_CHARITY_ID := v_charity_id;

                    -- Insert Primary Address location
                    INSERT INTO dl_charity_addresses (
                        charity_id,
                        city,
                        state_id,
                        is_primary
                    ) VALUES (
                        v_charity_id,
                        :P9_CITY,
                        TO_NUMBER(:P9_STATE_ID),
                        'Y'
                    );
                END;
                ```
        }
    )

    branch branch-to-organization-profile (
        name: "Branch to Organization Profile"
        execution {
            sequence: 10
            point: afterProcessing
        }
        target {
            page: 7
            setItems {
                P7_CHARITY_ID: "&P9_NEW_CHARITY_ID."
            }
        }
    )
)