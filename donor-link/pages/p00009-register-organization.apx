page 9 (
    name: "Register Organization"
    alias: REGISTER-ORGANIZATION
    title: "Register Your Charity" 
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region form (
        name: "Organization Registration"
        type: staticContent
        layout {
            sequence: 20
            slot: afterHeader
        }
    )

    pageItem P9_LEGAL_NAME (
        type: textField
        label {
            label: "Legal Organization Name"
        }
        validation {
            valueRequired: true
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
    )

    pageItem P9_NEW_CHARITY_ID (
        type: hidden
        layout {
            sequence: 5
            region: @form
            slot: regionBody
        }
    )

    pageItem P9_EIN_NUMBER (
        type: textField
        label {
            label: "EIN / Tax ID Number"
        }
        validation {
            valueRequired: true
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody        
        }
        appearance {
            valuePlaceholder: "e.g. 12-3456789"
        }
    )

    pageItem P9_PUBLIC_EMAIL (
        type: textField
        label {
            label: "Public Contact Email"
        }
        validation {
            valueRequired: true
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            valuePlaceholder: "contact@organization.org"
        }
    )

    pageItem P9_CITY (
        type: textField
        label {
            label: "City"
        }
        validation {
            valueRequired: true
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            valuePlaceholder: "e.g. Austin"
        }
    )

    pageItem P9_STATE_ID (
        type: selectList
        label {
            label: "State"
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT state_name || ' (' || state_code || ')' AS d, state_id AS r
                  FROM dl_us_states
                 ORDER BY state_name
                ```
            displayNullValue: true
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
        }
    )

    region footer-buttons-region (
        name: "Buttons"
        type: staticContent
        layout {
            sequence: 20
            slot: beforeFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    button cancel (
        buttonName: CANCEL
        label: "Cancel"
        layout {
            sequence: 10
            region: @footer-buttons-region
            slot: previous 
        }
        behavior {
            action: definedByDynamicAction
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
    )

    button save ( 
        buttonName: SAVE
        label: "Complete Registration & Build Profile"
        layout {
            sequence: 20
            region: @footer-buttons-region
            slot: next
        }
        behavior { 
            action: submitPage            
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )
    dynamicAction cancel-dialog (
        name: "Cancel Dialog"
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    ) 
    
    process create-organization-profile (
        name: "Create Organization Profile"
        type: executeCode
        
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_charity_id NUMBER;
                    v_slug       VARCHAR2(255);
                BEGIN
                    -- Generate clean public slug from legal name
                    v_slug := LOWER(REGEXP_REPLACE(:P9_LEGAL_NAME, '[^a-zA-Z0-9]+', '-'));
                    v_slug := TRIM(BOTH '-' FROM v_slug);

                    -- Insert new Charity Profile record
                    INSERT INTO dl_charity_profiles (
                        legal_name,
                        ein_number,
                        public_email,
                        public_slug,
                        tax_exempt_status,
                        mission_statement,
                        created_at
                    ) VALUES (
                        :P9_LEGAL_NAME,
                        :P9_EIN_NUMBER,
                        :P9_PUBLIC_EMAIL,
                        v_slug,
                        '501(c)(3) Verified',
                        'Connecting generous donors directly with verified community needs.',
                        SYSDATE
                    )
                    RETURNING charity_id INTO v_charity_id;

                    :P9_NEW_CHARITY_ID := v_charity_id;

                    -- Insert Primary Address location
                    INSERT INTO dl_charity_addresses (
                        charity_id,
                        city,
                        state_id,
                        is_primary
                    ) VALUES (
                        v_charity_id,
                        :P9_CITY,
                        TO_NUMBER(:P9_STATE_ID),
                        'Y'
                    );
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
    )

        branch (
        name: Go to page 7
        execution {
            sequence: 20
        }
        behavior {
                   target: {
                page: 7
                items: [
                    { name: "P7_CHARITY_ID", value: &P9_NEW_CHARITY_ID. }
                ]
            }
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )
)