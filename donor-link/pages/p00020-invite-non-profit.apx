page 20 (
    name: Invite Non-Profit
    alias: INVITE-NON-PROFIT
    title: Nominate a Non-Profit — DonorLink
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-region (
        name: Modal Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region invite-form-region (
        name: Nominate & Invite
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P20_CHARITY_EMAIL (
        type: textField
        label {
            label: Organization Contact Email
        }
        layout {
            sequence: 20
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            valuePlaceholder: info@organization.org
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
    )

    pageItem P20_CHARITY_NAME (
        type: textField
        label {
            label: Non-Profit Organization Name
        }
        layout {
            sequence: 10
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            valuePlaceholder: e.g. Hope Community Food Bank
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
    )

    pageItem P20_CHARITY_WEBSITE (
        type: textField
        label {
            label: Website or Social Link (Optional)
        }
        layout {
            sequence: 40
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            valuePlaceholder: e.g. organization.org
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P20_CONTACT_NAME (
        type: textField
        label {
            label: Contact Person Name (Optional)
        }
        layout {
            sequence: 30
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            valuePlaceholder: e.g. Maria Director
        }
        validation {
            maxLength: 150
        }
    )

    pageItem P20_PERSONAL_NOTE (
        type: textarea
        label {
            label: Personal Message / Invitation Note
        }
        settings {
            autoHeight: true
        }
        layout {
            sequence: 70
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            valuePlaceholder: Add a short note to the organization...
        }
        validation {
            maxLength: 1000
        }
        default {
            type: static
            staticValue: Hi! I love the work your organization does in our community. I am active on DonorLink and would love to see your needs listed here so donors can support you directly.
        }
    )

    pageItem P20_YOUR_EMAIL (
        type: textField
        label {
            label: Your Email Address (Optional)
        }
        layout {
            sequence: 60
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            valuePlaceholder: alex@example.com
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P20_YOUR_NAME (
        type: textField
        label {
            label: Your Name
        }
        layout {
            sequence: 50
            region: @invite-form-region
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            valuePlaceholder: e.g. Alex
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
    )

    button cancel_btn (
        buttonName: CANCEL_BTN
        label: Cancel
        layout {
            sequence: 10
            region: @buttons-region
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button send_invite_btn (
        buttonName: SEND_INVITE_BTN
        label: Send Invitation ✉️
        layout {
            sequence: 20
            region: @buttons-region
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-paper-plane
        }
    )

    dynamicAction cancel-dialog-da (
        name: Cancel Invitation Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel_btn
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog-after-send (
        name: Close Dialog After Send
        type: closeDialog
        execution {
            sequence: 20
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 42795839178229156
        }
        serverSideCondition {
            whenButtonPressed: @send_invite_btn
        }
    )

    process send-invitation-email (
        name: Send Invitation Process
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    -- Email dispatch logic will be attached here
                    NULL;
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 42795790939229156
        }
        serverSideCondition {
            whenButtonPressed: @send_invite_btn
        }
    )

)

