    /* 10. PL/SQL PRE-HEADER PROCESS */
    process fetch-charity-defaults (
        name: "Fetch Charity Defaults"
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P7_CHARITY_ID IS NULL THEN
                        SELECT charity_id INTO :P7_CHARITY_ID
                          FROM dl_charity_profiles
                         WHERE ROWNUM = 1;
                    END IF;
                
                    SELECT NVL(trading_name, legal_name),
                           tagline,
                           mission_statement,
                           about_us_narrative,
                           logo_url,
                           cover_photo_url,
                           website_url,
                           public_email,
                           primary_phone
                      INTO :P7_LEGAL_NAME,
                           :P7_TAGLINE,
                           :P7_MISSION_STATEMENT,
                           :P7_ABOUT_US_NARRATIVE,
                           :P7_LOGO_URL,
                           :P7_COVER_PHOTO_URL,
                           :P7_WEBSITE_URL,
                           :P7_PUBLIC_EMAIL,
                           :P7_PRIMARY_PHONE
                      FROM dl_charity_profiles
                     WHERE charity_id = TO_NUMBER(:P7_CHARITY_ID);
                EXCEPTION
                    WHEN OTHERS THEN
                        :P7_LEGAL_NAME := 'Organization Profile';
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    /* 11. DYNAMIC ACTIONS FOR DIALOG REFRESH (apexafterclosedialog) */
    dynamicAction refresh-hero-header-after-dialog (
        name: "Refresh Hero Header After Dialog Close"
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @hero-profile-header
        }
        action refresh-hero-header (
            action: refresh
            affectedElements {
                selectionType: region
                region: @hero-profile-header
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    dynamicAction refresh-about-story-after-dialog (
        name: "Refresh About Story After Dialog Close"
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
