    /* 5. SUB-TAB 2: IMPACT & SUCCESS STORIES */
    region portfolio-stories-tab (
        name: "Impact & Success Stories"
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    story_id,
                    title,
                    story_narrative,
                    NVL(media_url, 'https://via.placeholder.com/400x250?text=Impact+Story') AS media_url,
                    impact_metric,
                    TO_CHAR(event_date, 'Mon DD, YYYY') AS formatted_event_date
                FROM dl_charity_portfolio_stories
                WHERE charity_id = :P7_CHARITY_ID
                ORDER BY display_order ASC, story_id DESC
                ```
        }
        layout {
            sequence: 20
            parentRegion: @profile-tab-container
            slot: regionBody
