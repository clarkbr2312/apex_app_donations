    /* 3. PARENT TAB CONTAINER REGION */
    region profile-tab-container (
        name: "Profile Navigation Tabs"
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--pill
            ]
        }
    )

    /* 4. SUB-TAB 1: ACTIVE NEEDS WISHLIST */
    region wishlist-catalog-tab (
        name: "Active Needs Wishlist"
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    wi.item_id,
                    wi.product_title,
                    NVL(wi.product_image_url, 'https://via.placeholder.com/300x200?text=No+Image') AS product_image_url,
                    wi.target_price,
                    wi.pledged_amount,
                    wi.target_quantity,
                    wi.funded_quantity,
                    wi.priority_level,
                    wi.item_status,
                    ROUND((wi.pledged_amount / NULLIF(wi.target_price * wi.target_quantity, 0)) * 100) AS percent_funded
                FROM dl_charity_wishlist_items wi
                WHERE wi.charity_id = :P7_CHARITY_ID
                  AND wi.item_status = 'ACTIVE'
                ORDER BY wi.priority_level DESC, wi.item_id DESC
                ```
        }
        layout {
            sequence: 10
            parentRegion: @profile-tab-container
            slot: regionBody
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
                t-CardsRegion--styleA
            ]
        }
        componentAppearance {
            gridColumns: 3
        }
        card {
            primaryKeyColumn1: ITEM_ID
        }
        title {
            column: PRODUCT_TITLE
        }
        subtitle {
            column: PRIORITY_LEVEL
        }
        body {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div style="margin-top: 10px; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                    <div style="flex-grow: 1; background-color: #E5E7EB; height: 6px; border-radius: 3px; overflow: hidden;">
                        <div style="width: &PERCENT_FUNDED.%; background-color: #1B5B8A; height: 100%; border-radius: 3px;"></div>
                    </div>
                    <span style="color: #4B5563; font-weight: 600; font-size: 12px; white-space: nowrap;">&PERCENT_FUNDED.% Funded</span>
                </div>
                ```
        }
        secondaryBody {
            advancedFormatting: true
            htmlExpression: "$&TARGET_PRICE."
        }

        action edit_item_action (
            type: button
            label: "Edit Need"
            layout {
                position: primary
                sequence: 10
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 12
                    items: {
                        P12_ITEM_ID: "&ITEM_ID."
                        P12_CHARITY_ID: "&P7_CHARITY_ID."
                    }
                }
            }
            appearance {
                displayType: icon
                icon: "fa-pencil"
            }
        )

        action item_donate_action (
            label: "Fund This Need"
            layout {
                sequence: 20
            }
            behavior {
                type: redirectUrl
                targetUrl: "#"
            }
            appearance {
                cssClasses: "card-cta-donate"
            }
        )
    )

