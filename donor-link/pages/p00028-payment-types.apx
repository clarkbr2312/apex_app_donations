page 28 (
    name: Payment Types
    alias: PAYMENT-TYPES
    title: Payment Types
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region payment-types (
        name: Payment Types
        title: Payment Types
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: DL_PAYMENT_TYPE_LOOKUP
            orderByClause: type_name
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 46072612289509535
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TYPE_ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @TYPE_CODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @TYPE_NAME
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESCRIPTION
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IS_ACTIVE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DESCRIPTION (
            type: textField
            heading {
                heading: Description
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IS_ACTIVE (
            type: switch
            heading {
                heading: Enabled
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: IS_ACTIVE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TYPE_CODE (
            type: textField
            heading {
                heading: Type Code
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 30
            }
            source {
                databaseColumn: TYPE_CODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TYPE_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TYPE_ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column TYPE_NAME (
            type: textField
            heading {
                heading: Type Name
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 50
            }
            source {
                databaseColumn: TYPE_NAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Payment Types
        }
    )

    process payment-types-save-interactive-grid-data (
        name: Payment Types - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @payment-types
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 46073431945509543
        }
    )

)

